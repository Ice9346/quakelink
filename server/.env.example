DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quakelink
PORT=8080
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=
TB_BASE_URL=
TB_USERNAME=
TB_PASSWORD=
TB_DEVICE_ACCESS_TOKEN=
TB_SIMULATOR_ENABLE=false
TB_SIMULATOR_MS=300000
TB_SIMULATOR_SPACEBAR_ENABLE=false
GOOGLE_MAPS_API_KEY=
# ตรวจ token ทุก 2 ชั่วโมง และ login ใหม่อัตโนมัติเมื่อถึงรอบ
TB_TOKEN_REFRESH_MS=7200000
# ทดสอบ refresh หนึ่งครั้งหลัง server เริ่ม (แนะนำให้ false ใน production)
TB_TOKEN_REFRESH_DEMO=false
TB_TOKEN_REFRESH_DEMO_DELAY_MS=10000
TB_DEVICE_NAME=EarthquakeSensor001
TB_DEVICE_NAMES=EarthquakeSensor001,EarthquakeSensor003,EarthquakeSensor004,EarthquakeSensor005
TB_POLL_ENABLE=false
TB_POLL_MS=3000
TB_LATESTALL_WS_ENABLE=true
TB_LATESTALL_WS_MS=5000
LATENCY_LOG_ENABLE=false

GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=quakelink://auth/github
